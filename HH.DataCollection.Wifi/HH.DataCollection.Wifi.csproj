<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProductVersion>8.0.30703</ProductVersion>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{B7C2A1E4-3D5F-4A6B-9C8D-1E2F3A4B5C6D}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <!-- 程序图标(原汇海发布目录 HXHH_green.ico 的副本,已纳入本仓库 lib) -->
    <ApplicationIcon>$(SolutionDir)lib\HXHH_green.ico</ApplicationIcon>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>HH.DataCollection.Wifi</RootNamespace>
    <AssemblyName>HH.DataCollection.Wifi</AssemblyName>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup>
    <!-- 依赖库目录:从原汇海发布目录复制的必要组件(原始未补丁版),已纳入 git,构建不再依赖 Guojiatizhi -->
    <HuiHaiDir>$(SolutionDir)lib\</HuiHaiDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(HuiHaiDir)Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Model">
      <HintPath>$(HuiHaiDir)Model.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BLL">
      <HintPath>$(HuiHaiDir)BLL.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UI">
      <HintPath>$(HuiHaiDir)UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Device">
      <HintPath>$(HuiHaiDir)Device.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="LJH.GeneralLibrary">
      <HintPath>$(HuiHaiDir)LJH.GeneralLibrary.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HH.TiYu.SQLite">
      <HintPath>$(HuiHaiDir)HH.TiYu.SQLite.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Data.SQLite">
      <HintPath>$(HuiHaiDir)System.Data.SQLite.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="FrmMain.cs" />
    <Compile Include="FrmSelectProject.cs" />
    <Compile Include="Db\LocalDb.cs" />
    <Compile Include="Sync\SyncConfig.cs" />
    <Compile Include="Sync\SyncApi.cs" />
    <Compile Include="Sync\StudentSync.cs" />
    <Compile Include="Sync\ScoreUpload.cs" />
    <Compile Include="Sync\FrmSyncSettings.cs" />
    <Compile Include="Sync\FrmSyncTasks.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- 工具栏图标,由 tools\ExtractIcons.ps1 从原软件 GuojiaTiZhi.exe 资源提取 -->
    <EmbeddedResource Include="Resources\wireless.png" />
    <EmbeddedResource Include="Resources\upload.png" />
    <EmbeddedResource Include="Resources\network.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HH.TiYu.DAL\HH.TiYu.DAL.csproj">
      <Project>{C4E3D764-8282-4A96-B44E-289346D9EF50}</Project>
      <Name>HH.TiYu.DAL</Name>
      <Private>True</Private>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="AfterBuild">
    <!-- 从本仓库 lib 复制运行依赖和配置；DAL 使用源码项目的构建产物。 -->
    <!-- DAL 由源码项目构建，禁止旧 lib/DAL.dll 覆盖项目引用的产物。 -->
    <ItemGroup>
      <RuntimeLibraries Include="$(HuiHaiDir)*.dll" Exclude="$(HuiHaiDir)DAL.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeLibraries)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Exec Command="xcopy &quot;$(HuiHaiDir)config.xml&quot; &quot;$(TargetDir)&quot; /D /Y /R" />
    <Exec Command="xcopy &quot;$(HuiHaiDir)DbUpdate_SQLITE.sql&quot; &quot;$(TargetDir)&quot; /D /Y /R" />
    <!-- 补丁:摘空输出目录 BLL.dll 拷贝件中 PhysicalScoresSavingService.AddScore/AddScores,主库成绩表不写 -->
    <Exec Command="&quot;$(SolutionDir)tools\PatchBll.exe&quot; &quot;$(TargetDir)BLL.dll&quot;" />
    <!-- 补丁:把输出目录 Model.dll 拷贝件中硬编码的 HHRawScore.db 改为 HuihaiTiyu.db(原始成绩落主库,单库方案) -->
    <Exec Command="&quot;$(SolutionDir)tools\PatchBll.exe&quot; &quot;$(TargetDir)Model.dll&quot;" />
  </Target>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProductVersion>8.0.30703</ProductVersion>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{B7C2A1E4-3D5F-4A6B-9C8D-1E2F3A4B5C6D}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <!-- 程序图标(原汇海发布目录 HXHH_green.ico 的副本,已纳入本仓库 lib) -->
    <ApplicationIcon>$(SolutionDir)lib\HXHH_green.ico</ApplicationIcon>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>HH.DataCollection.Wifi</RootNamespace>
    <AssemblyName>HH.DataCollection.Wifi</AssemblyName>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup>
    <!-- 依赖库目录:从原汇海发布目录复制的必要组件(原始未补丁版),已纳入 git,构建不再依赖 Guojiatizhi -->
    <HuiHaiDir>$(SolutionDir)lib\</HuiHaiDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(HuiHaiDir)Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Data.SQLite">
      <HintPath>$(HuiHaiDir)System.Data.SQLite.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Shell\FrmMain.cs" />
    <Compile Include="Shell\FrmSelectProject.cs" />
    <Compile Include="Db\LocalDb.cs" />
    <Compile Include="Sync\SyncConfig.cs" />
    <Compile Include="Sync\SyncApi.cs" />
    <Compile Include="Sync\StudentSync.cs" />
    <Compile Include="Sync\ScoreUpload.cs" />
    <Compile Include="Sync\Views\FrmSyncSettings.cs" />
    <Compile Include="Sync\Views\FrmSyncTasks.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- 工具栏图标,由 tools\ExtractIcons.ps1 从原软件 GuojiaTiZhi.exe 资源提取 -->
    <EmbeddedResource Include="Resources\wireless.png" />
    <EmbeddedResource Include="Resources\upload.png" />
    <EmbeddedResource Include="Resources\network.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HH.TiYu.DAL\HH.TiYu.DAL.csproj">
      <Project>{C4E3D764-8282-4A96-B44E-289346D9EF50}</Project>
      <Name>HH.TiYu.DAL</Name>
      <Private>True</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HH.TiYu.Model\HH.TiYu.Model.csproj">
      <Project>{6E371ED2-8AB5-4D26-8C53-DC5A635CC801}</Project>
      <Name>HH.TiYu.Model</Name>
      <Private>True</Private>
    </ProjectReference>
    <ProjectReference Include="..\HH.TiYu.BLL\HH.TiYu.BLL.csproj">
      <Project>{C6AE204B-4D6A-409A-A684-0E2F79AB7802}</Project>
      <Name>HH.TiYu.BLL</Name>
      <Private>True</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HH.TiYu.SQLite\HH.TiYu.SQLite.csproj"><Project>{DA46F333-0A97-4B57-83E6-1F4B6EE9B161}</Project><Name>HH.TiYu.SQLite</Name><Private>True</Private></ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HH.TiYu.Device\HH.TiYu.Device.csproj"><Project>{8537D017-64FB-4681-B994-4CA2E4FC245C}</Project><Name>HH.TiYu.Device</Name><Private>True</Private></ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HH.TiYu.UI\HH.TiYu.UI.csproj"><Project>{ACF17DAA-F539-4404-8911-67D2B85FD3B2}</Project><Name>HH.TiYu.UI</Name><Private>True</Private></ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LJH.GeneralLibrary\LJH.GeneralLibrary.csproj"><Project>{C70B95A5-1217-4E8A-A409-E997982C6E2D}</Project><Name>LJH.GeneralLibrary</Name><Private>True</Private></ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="AfterBuild">
    <!-- 从 lib 复制通用运行依赖；Model、DAL、BLL、SQLite、Device、UI、LJH 使用源码项目的构建产物。 -->
    <!-- 禁止原始 lib 中的业务程序集覆盖项目引用的产物。 -->
    <ItemGroup>
      <RuntimeLibraries Include="$(HuiHaiDir)*.dll" Exclude="$(HuiHaiDir)DAL.dll;$(HuiHaiDir)Model.dll;$(HuiHaiDir)BLL.dll;$(HuiHaiDir)HH.TiYu.SQLite.dll;$(HuiHaiDir)Device.dll;$(HuiHaiDir)UI.dll;$(HuiHaiDir)LJH.GeneralLibrary.dll;$(HuiHaiDir)AForge.dll;$(HuiHaiDir)AForge.Controls.dll;$(HuiHaiDir)AForge.Imaging.dll;$(HuiHaiDir)AForge.Math.dll;$(HuiHaiDir)AForge.Video.dll;$(HuiHaiDir)AForge.Video.DirectShow.dll;$(HuiHaiDir)FJ.CoreWin.dll;$(HuiHaiDir)JpgDll.dll;$(HuiHaiDir)SavePhoto.dll" />
    </ItemGroup>
    <Delete Files="$(TargetDir)AForge.dll;$(TargetDir)AForge.Controls.dll;$(TargetDir)AForge.Imaging.dll;$(TargetDir)AForge.Math.dll;$(TargetDir)AForge.Video.dll;$(TargetDir)AForge.Video.DirectShow.dll;$(TargetDir)FJ.CoreWin.dll;$(TargetDir)JpgDll.dll;$(TargetDir)SavePhoto.dll" />
    <Copy SourceFiles="@(RuntimeLibraries)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Exec Command="xcopy &quot;$(HuiHaiDir)config.xml&quot; &quot;$(TargetDir)&quot; /D /Y /R" />
    <Exec Command="xcopy &quot;$(HuiHaiDir)DbUpdate_SQLITE.sql&quot; &quot;$(TargetDir)&quot; /D /Y /R" />
  </Target>
</Project>
